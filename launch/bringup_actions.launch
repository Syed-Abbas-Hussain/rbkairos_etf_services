<launch>

  <!-- ========================= -->
  <!-- Common arguments          -->
  <!-- ========================= -->
  <arg name="world_frame" default="fr3_link0" />
  <arg name="gripper_speed" default="0.1" />

  <!-- ========================= -->
  <!-- Robot 1 action stack      -->
  <!-- ========================= -->
  <group ns="robot1">

    <!-- Move Base Service -->
    <node pkg="rbkairos_etf_services"
          type="move_rbkairos.py"
          name="move_base_service_node"
          output="screen">
      <param name="command_topic" value="/robot1/command_manager/command" />
      <param name="status_topic"  value="/robot1/command_manager/status" />
    </node>

    <!-- Move Arm Service -->
    <node pkg="rbkairos_etf_services"
          type="move_moveit_fr3.py"
          name="move_arm_service_node"
          output="screen" />

    <!-- Action Server -->
    <node pkg="rbkairos_etf_services"
          type="action_manager.py"
          name="action_server_node"
          output="screen">
      <param name="robot_namespace"  value="robot1" />
      <param name="world_frame"      value="$(arg world_frame)" />
      <param name="gripper_action"   value="/robot1/arm/franka_gripper/move" />
      <param name="gripper_speed"    value="$(arg gripper_speed)" />
    </node>

  </group>

  <!-- ========================= -->
  <!-- Robot 2 action stack      -->
  <!-- ========================= -->
  <group ns="robot2">

    <!-- Move Base Service -->
    <node pkg="rbkairos_etf_services"
          type="move_rbkairos.py"
          name="move_base_service_node"
          output="screen">
      <param name="command_topic" value="/robot2/command_manager/command" />
      <param name="status_topic"  value="/robot2/command_manager/status" />
    </node>

    <!-- Move Arm Service -->
    <node pkg="rbkairos_etf_services"
          type="move_moveit_fr3.py"
          name="move_arm_service_node"
          output="screen" />

    <!-- Action Server -->
    <node pkg="rbkairos_etf_services"
          type="action_manager.py"
          name="action_server_node"
          output="screen">
      <param name="robot_namespace"  value="robot2" />
      <param name="world_frame"      value="$(arg world_frame)" />
      <param name="gripper_action"   value="/robot2/arm/franka_gripper/move" />
      <param name="gripper_speed"    value="$(arg gripper_speed)" />
    </node>

  </group>

</launch>
