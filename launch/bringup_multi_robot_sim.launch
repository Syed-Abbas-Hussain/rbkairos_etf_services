<launch>

  <!-- ========================= -->
  <!-- Common arguments          -->
  <!-- ========================= -->

  <!-- Number of robots (currently 2; add more <group> blocks below to extend) -->
  <!-- Namespaces must match the RDDL instance robot names mapped in evaluator  -->
  <arg name="robot_namespaces" default="robot0,robot1" />

  <!-- RDDL files (relative to the package's problem_data/ directory) -->
  <arg name="domain_name"   default="domain_new.rddl" />
  <arg name="instance_name" default="instance_new_sim.rddl" />
  <arg name="actions_name"  default="actions.json" />

  <!-- Arm/world frame used by MoveIt (one per robot if they differ, override below) -->
  <arg name="world_frame" default="fr3_link0" />


  <!-- ========================= -->
  <!-- Robot 0 action stack      -->
  <!-- Gazebo topics/services for this robot must be namespaced under /robot0/ -->
  <!-- ========================= -->
  <group ns="robot0">

    <!-- Low-level base driver (talks to /robot0/command_manager/...) -->
    <node pkg="rbkairos_etf_services"
          type="move_rbkairos.py"
          name="move_base_service_node"
          output="screen">
      <param name="command_topic" value="/robot0/command_manager/command" />
      <param name="status_topic"  value="/robot0/command_manager/status" />
    </node>

    <!-- Low-level arm driver (MoveIt group "arm" must be scoped to this robot) -->
    <node pkg="rbkairos_etf_services"
          type="move_moveit_fr3.py"
          name="move_arm_service_node"
          output="screen">
      <param name="world_frame" value="$(arg world_frame)" />
    </node>

    <!-- High-level action manager for robot0 -->
    <node pkg="rbkairos_etf_services"
          type="action_manager.py"
          name="action_server_node"
          output="screen">
      <param name="move_base_service"     value="/robot0/move_base" />
      <param name="move_arm_service"      value="/robot0/move_arm" />
      <param name="action_server_name"    value="/robot0/action_server" />
      <param name="action_feedback_topic" value="/robot0/action_feedback" />
      <param name="world_frame"           value="$(arg world_frame)" />
      <param name="gripper_action"        value="/robot0/arm/franka_gripper/move" />
    </node>

  </group>


  <!-- ========================= -->
  <!-- Robot 1 action stack      -->
  <!-- ========================= -->
  <group ns="robot1">

    <node pkg="rbkairos_etf_services"
          type="move_rbkairos.py"
          name="move_base_service_node"
          output="screen">
      <param name="command_topic" value="/robot1/command_manager/command" />
      <param name="status_topic"  value="/robot1/command_manager/status" />
    </node>

    <node pkg="rbkairos_etf_services"
          type="move_moveit_fr3.py"
          name="move_arm_service_node"
          output="screen">
      <param name="world_frame" value="$(arg world_frame)" />
    </node>

    <node pkg="rbkairos_etf_services"
          type="action_manager.py"
          name="action_server_node"
          output="screen">
      <param name="move_base_service"     value="/robot1/move_base" />
      <param name="move_arm_service"      value="/robot1/move_arm" />
      <param name="action_server_name"    value="/robot1/action_server" />
      <param name="action_feedback_topic" value="/robot1/action_feedback" />
      <param name="world_frame"           value="$(arg world_frame)" />
      <param name="gripper_action"        value="/robot1/arm/franka_gripper/move" />
    </node>

  </group>


  <!-- ========================= -->
  <!-- PROST service caller       -->
  <!-- mode=gazebo routes each    -->
  <!-- planner action to the      -->
  <!-- correct robot by index     -->
  <!-- ========================= -->
  <node pkg="rbkairos_etf_services"
        type="service_caller.py"
        name="prost_service_caller"
        output="screen">
    <param name="mode"             value="gazebo" />
    <param name="robot_namespaces" value="$(arg robot_namespaces)" />
    <param name="domain_name"      value="$(arg domain_name)" />
    <param name="instance_name"    value="$(arg instance_name)" />
    <param name="actions_name"     value="$(arg actions_name)" />
  </node>

</launch>
